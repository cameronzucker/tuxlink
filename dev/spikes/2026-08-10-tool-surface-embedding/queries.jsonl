# Labeled plain-language operator asks against resources/agents/tool-surface.jsonl
# (the registry-generated tool corpus). Same schema family as the catalog set at
# dev/spikes/2026-08-09-t1-catalog-embedding/queries.jsonl.
# kind: tool (specific tool(s) correct) | ambig (several defensible; margin-only) | none (no tool should be called)
# behavior: answer (pick confidently) | ask (surface candidates / clarify)
{"id":"armed-check","q":"am I allowed to transmit right now","expect":{"kind":"tool","tools":["server_info"]},"behavior":"answer"}
{"id":"backend-up","q":"is the winlink engine connected","expect":{"kind":"tool","tools":["backend_status"]},"behavior":"answer"}
